{
  "name": "stgadgets-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "cd ../.. && oxlint --type-aware --deny-warnings src/ui packs tests/ui",
    "format": "cd ../.. && oxfmt 'src/ui/src/**/*.{ts,tsx}' 'src/ui/*.ts' 'packs/*/derived.js' 'packs/*/ui/**/*.{ts,tsx}' 'packs/*/tests/**/*.{ts,tsx}' 'tests/ui/**/*.{ts,tsx}'",
    "format:check": "cd ../.. && oxfmt --check 'src/ui/src/**/*.{ts,tsx}' 'src/ui/*.ts' 'packs/*/derived.js' 'packs/*/ui/**/*.{ts,tsx}' 'packs/*/tests/**/*.{ts,tsx}' 'tests/ui/**/*.{ts,tsx}'",
    "screenshot": "node screenshot.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
