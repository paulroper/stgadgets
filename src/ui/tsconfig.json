{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    // What game packs (../../packs/*/ui) may import; keep in sync with vite.config.ts. React is mapped too,
    // because packs live outside this folder and wouldn't find node_modules otherwise.
    "paths": {
      "@stgadgets/sdk": ["./src/sdk/index.ts"],
      "@stgadgets/gadgets": ["./src/gadgets/index.ts"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"]
    }
  },
  "include": ["src", "../../packs/*/ui", "vite.config.ts"]
}
