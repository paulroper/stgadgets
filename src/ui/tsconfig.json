{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    // Vite and Oxc compile one file at a time, and screenshot.ts runs as plain `node screenshot.ts`, which only strips types.
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    // What game packs (../../packs/*/ui and ../../packs/*/tests) may import; keep in sync with vite.config.ts. React is mapped too,
    // because packs and tests (../../tests/ui) live outside this folder and wouldn't find node_modules otherwise.
    "paths": {
      "@stgadgets/sdk": ["./src/sdk/index.ts"],
      "@stgadgets/gadgets": ["./src/gadgets/index.ts"],
      "@stgadgets/testing": ["../../tests/ui/testing.ts"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "vitest": ["./node_modules/vitest"],
      "@testing-library/react": ["./node_modules/@testing-library/react"]
    }
  },
  "include": ["src", "../../packs/*/ui", "../../packs/*/tests", "../../tests/ui", "vite.config.ts", "screenshot.ts"]
}
