<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\lib\Stgadgets.Host.Lib.Api\Stgadgets.Host.Lib.Api.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net10.0-macos</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
    <TrimMode Condition="'$(Configuration)' == 'Release'">full</TrimMode>

    <!--
      Workload 27.0.10722 requires exactly Xcode 27.0; we build with 27.1 (see README).
      Remove once a workload supports the installed Xcode.
    -->
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
  </PropertyGroup>
</Project>
